# Copiar a database/.env y completar localmente. No contiene credenciales válidas.
NODE_ENV=development
PORT=3000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=bebederos_dev
DB_USER=bebederos_dev
DB_PASSWORD=
# Generar dos valores DISTINTOS: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
OUTBOX_SECRET=
APP_URL=http://localhost:5173
VISIT_RADIUS_METERS=5
TRUST_PROXY=0
# Opcionales en preparación; necesarios al habilitar correo real.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Solo backend; configurar modalidad comercial antes de operar.
WEATHER_URL=https://customer-api.open-meteo.com/v1/forecast
WEATHER_API_KEY=
# Fuente pública sin secretos. Para Vite usar VITE_TILE_URL en frontend (ver deployment/README.md).
MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
# Solo para seed/cuentas de prueba; jamás producción.
DEMO_PASSWORD=

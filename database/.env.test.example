# Copiar a .env.test. Crear previamente una base MySQL 8 y usuario exclusivos.
NODE_ENV=test
# Nombre de la base operativa usado SOLO para rechazar colisiones; no se conecta a ella.
DB_NAME=bebederos_dev
TEST_DB_HOST=127.0.0.1
TEST_DB_PORT=3306
TEST_DB_NAME=bebederos_test
TEST_DB_USER=bebederos_test
TEST_DB_PASSWORD=
# El usuario debe tener permisos únicamente sobre bebederos_test.*.
